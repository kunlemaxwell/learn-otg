# Learn OTG settings. Copy this file to .env.local and fill in what you want.
# Every value is optional. With no keys at all, the app runs in demo mode
# (canned lessons and courses, no model calls), so you can try it right away.
# These stay on the server and are never sent to the browser.

# NVIDIA-hosted models (GLM, Kimi). Free key: sign in at https://build.nvidia.com,
# open a model page, choose "Get API Key". Keys start with nvapi-
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq (fast models: Qwen, GPT-OSS). Free key at https://console.groq.com/keys.
# Keys start with gsk_ . Free tier is about 30 requests and 8K tokens a minute.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional, better web search. Without them the app uses DuckDuckGo and Wikipedia.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Force demo mode even when keys are set (1 = on). You can also open any page with ?mock=1.
LEARN_OTG_MOCK=
